{
  "name": "dsh-opencode-go-session",
  "version": "0.1.1",
  "description": "Sends a stable per-conversation x-opencode-session header to OpenCode Go (and any pi-ai endpoint) through the harness header hook, so routing and prompt caching stay per conversation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sw503544488/dsh-opencode-go-session.git"
  },
  "homepage": "https://github.com/sw503544488/dsh-opencode-go-session#readme",
  "bugs": {
    "url": "https://github.com/sw503544488/dsh-opencode-go-session/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "plugin",
    "opencode",
    "session",
    "prompt-cache"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
